{
  "name": "quasar-theme",
  "displayName": "Quasar Theme",
  "description": "Quasar: three dark themes for out of space \u2014 Dark, Ink and Navy.",
  "version": "0.0.1",
  "publisher": "sailfact",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sailfact/quasar-theme.git"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "color-theme",
    "quasar",
    "rose",
    "navy"
  ],
  "galleryBanner": {
    "color": "#1e2436",
    "theme": "dark"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "verify": "node scripts/verify.js",
    "lint": "node scripts/lint.js",
    "vscode:prepublish": "node scripts/build.js",
    "release": "node scripts/release.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "js-yaml": "^4.1.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Quasar Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/quasar-dark-color-theme.json"
      },
      {
        "label": "Quasar Ink",
        "uiTheme": "vs-dark",
        "path": "./themes/quasar-ink-color-theme.json"
      },
      {
        "label": "Quasar Navy",
        "uiTheme": "vs-dark",
        "path": "./themes/quasar-navy-color-theme.json"
      }
    ]
  }
}
